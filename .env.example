# Claude tab (get a key at https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Phone reminders via ntfy. Leave NTFY_TOPIC empty and one is generated on first run.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Two-way sync with a calendar in macOS Calendar.app (shows up on your phone if it is an iCloud calendar).
CALENDAR_SYNC=1
CALENDAR_SYNC_NAME=multiapp
